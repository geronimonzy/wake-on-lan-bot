# Telegram Wake-on-LAN Bot - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# REQUIRED: Telegram Bot Configuration
# ============================================

# Get your bot token from @BotFather on Telegram
# Format: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Authorized Telegram user IDs (space-separated)
# Get your user ID from @userinfobot on Telegram
# Format: Space-separated numbers, e.g., "123456789 987654321"
AUTHORIZED_USERS=123456789 987654321

# ============================================
# OPTIONAL: Network Configuration
# ============================================

# Default network interface for WOL packets (optional)
# Common values: br-lan, eth0, eth1, eno1
# Leave empty to use system default
DEFAULT_INTERFACE=

# ============================================
# OPTIONAL: Rate Limiting
# ============================================

# Minimum seconds between WOL commands for the same device
# Default: 10 seconds
RATE_LIMIT_SECONDS=10

# ============================================
# OPTIONAL: Paths (only change if needed)
# ============================================

# Device configuration file path
# Default: /app/devices.conf
# CONFIG_FILE=/app/devices.conf

# State file path
# Default: /app/state/offset
# STATE_FILE=/app/state/offset

# ============================================
# OPTIONAL: Timezone
# ============================================

# Container timezone
# Default: UTC
TZ=UTC