#!/bin/sh /etc/rc.common
# Telegram WOL Bot - OpenWRT Init Script
# /etc/init.d/telegram-wol-bot

START=99
STOP=10

USE_PROCD=1
PROG=/root/wol-bot/telegram-wol-bot.sh
PIDFILE=/var/run/telegram-wol-bot.pid

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh $PROG
    procd_set_param pidfile $PIDFILE
    procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
    
    echo "Telegram WOL Bot started"
}

stop_service() {
    echo "Stopping Telegram WOL Bot"
    # Use PID file instead of killall
    if [ -f "$PIDFILE" ]; then
        local pid=$(cat "$PIDFILE" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            kill -TERM "$pid"
            # Wait for process to terminate
            local count=0
            while kill -0 "$pid" 2>/dev/null && [ $count -lt 10 ]; do
                sleep 1
                count=$((count + 1))
            done
            # Force kill if still running
            if kill -0 "$pid" 2>/dev/null; then
                kill -KILL "$pid" 2>/dev/null
            fi
        fi
        rm -f "$PIDFILE"
    else
        # Fallback: if no PID file, try to find and stop the process
        pkill -TERM -f "$PROG"
    fi
}

reload_service() {
    stop_service
    start_service
}

status() {
    if pgrep -f "$PROG" > /dev/null; then
        echo "Telegram WOL Bot is running (PID: $(pgrep -f "$PROG"))"
        return 0
    else
        echo "Telegram WOL Bot is not running"
        return 1
    fi
}
