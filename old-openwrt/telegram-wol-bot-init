#!/bin/sh /etc/rc.common
# Telegram WOL Bot - OpenWRT Init Script
# /etc/init.d/telegram-wol-bot

START=99
STOP=10

USE_PROCD=1
PROG=/root/wol-bot/telegram-wol-bot.sh
PIDFILE=/var/run/telegram-wol-bot.pid

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh $PROG
    procd_set_param pidfile $PIDFILE
    procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
    
    echo "Telegram WOL Bot started"
}

stop_service() {
    echo "Stopping Telegram WOL Bot"
    # Kill any running instances
    killall telegram-wol-bot.sh 2>/dev/null
    # Clean up PID file
    rm -f $PIDFILE
}

reload_service() {
    stop
    start
}

status() {
    if pgrep -f "$PROG" > /dev/null; then
        echo "Telegram WOL Bot is running (PID: $(pgrep -f "$PROG"))"
        return 0
    else
        echo "Telegram WOL Bot is not running"
        return 1
    fi
}
